# ── Backend ──────────────────────────────────────────────────────────────────

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/nutriguide

# PostgreSQL connection string (Prisma)
# Local:    postgresql://postgres:123456@localhost:5432/nutriguide
# Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# Railway:  postgresql://postgres:[password]@[host]:5432/railway
DATABASE_URL=postgresql://postgres:123456@localhost:5432/nutriguide

# JWT secret — change this to a long random string in production
JWT_SECRET=nutriguide_jwt_secret_change_me

# Express session secret
SESSION_SECRET=nutriguide_session_secret_change_me

# Server port
PORT=3001

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Environment
NODE_ENV=development

# ── Cloudinary (avatar / image uploads) ──────────────────────────────────────
# Sign up at cloudinary.com → Dashboard → copy these 3 values
CLOUDINARY_CLOUD_NAME=djawchoe9
CLOUDINARY_API_KEY=257672679452991
CLOUDINARY_API_SECRET=7ZRn4Y1vet7DejDnzGzxUTMakoU

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# If running frontend separately (not via Vite proxy), set this
VITE_API_URL=http://localhost:3001
